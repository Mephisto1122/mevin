# Mevin environment variables
# Copy to .env (docker compose reads it automatically) or export them before `python mevin.py`.
# Telegram / ntfy alerts are configured in the dashboard Settings, not here.

# Access token. When set, the dashboard asks for it once and every API call,
# live stream and snapshot requires it. Strongly recommended if others share your network.
MEVIN_TOKEN=

# Where Ollama is running (default http://localhost:11434)
# MEVIN_OLLAMA_URL=http://localhost:11434

# Web server
# MEVIN_PORT=5555
# MEVIN_HOST=0.0.0.0        # use 127.0.0.1 to allow only this computer

# Storage
# MEVIN_DB=monitor.db
# MEVIN_SNAPSHOTS=snapshots

# Analysis
# MEVIN_WORKERS=1           # 0 = analyse inside the web process
# MEVIN_GPU_SLOTS=1         # concurrent VLM calls; raise on big / multi-GPU setups
